  "semanticFactGraph": {
    "fields": [
      "category",
      "topicFamily",
      "scope",
      "subject",
      "askedProperty",
      "correctAnswer",
      "factCluster",
      "precisionRequired"
    ],
    "duplicateSignature": [
      "subject",
      "askedProperty",
      "correctAnswer"
    ],
    "sameFactClusterWithinQuiz": "RED",
    "reverseRelationshipWithinQuiz": "RED"
  },
  "answerLeakageGraph": {
    "hardFail": [
      "correct_answer_explicit_in_other_stem",
      "correct_answer_semantically_revealed_by_other_stem",
      "reverse_question_pair",
      "near_property_pair_that_solves_other_question",
      "other_options_create_strong_answer_hint"
    ],
    "automationPolicy": "mechanical_candidates_are_review_signals; semantic_verdict_required"
  },
  "questionForms": {
    "allowed": [
      "direct_identification",
      "relationship",
      "chronology",
      "comparison",
      "classification",
      "cause_effect",
      "light_inference",
      "approximation_or_range",
      "visual_recognition"
    ],
    "hardQuota": false,
    "avoidMonoculture": true,
    "trickQuestions": "RED"
  },
  "topicDiversity": {
    "hard": {
      "sameFactClusterMaxPerQuiz": 1,
      "sameTopicFamilyMaxPerQuiz": 2,
      "sameTopicFamilyAdjacent": false
    },
    "soft": {
      "minimumDistinctCategories": null,
      "categoryHardQuota": false,
      "maximizeCategoryDiversity": true,
      "recentQuizLookback": 5,
      "overusedTopicFamily": "novelty_penalty_only"
    }
  },
  "precisionBurden": {
    "levels": {
      "P0": {
        "label": "low",
        "policy": "PASS"
      },
      "P1": {
        "label": "medium",
        "policy": "PASS"
      },
      "P2": {
        "label": "exact_salient",
        "policy": "REVIEW"
      },
      "P3": {
        "label": "exact_obscure",
        "policy": "RED"
      }
    },
    "nearNumericLottery": "RED",
    "rewritePreference": [
      "period_or_century",
      "before_after",
      "approximate_range",
      "relationship_or_comparison"
    ]
  },
  "cueGuessability": {
    "optionWordCountMaxMinPreferredRatio": 3.0,
    "uniqueLongestCorrectTargetMaxRate": 0.1,
    "checks": [
      "unique_length_outlier",
      "unique_specificity_or_technicality",
      "stem_option_lexical_echo",
      "grammar_only_matches_correct",
      "semantic_class_outlier",
      "numeric_visual_pattern",
      "correct_option_explains_more_than_distractors"
    ]
  },
  "answerDistribution": {
    "eachPositionAtLeast": 1,
    "singlePositionMax": 5,
    "fixedPattern": false
  },
  "duplicateQA": {
    "exactNormalized": "RED",
    "fuzzyStemReviewThreshold": 0.84,
    "semanticFactDuplicate": "RED"
  },
  "sourceQA": {
    "changingFactsRequireCurrentVerification": true,
    "preferPrimaryOfficialSources": true,
    "ambiguousMultipleDefensibleAnswers": "RED"
  },
  "technicalQA": {
    "yq133Plus": {
      "schemaVersion": 2,
      "questionCount": 10,
      "optionsPerQuestion": 4,
      "questionSeconds": 20,
      "questionType": "multiple-choice",
      "uniqueQuestionIds": true,
      "uniqueOptionsWithinQuestion": true
    }
  }
}
